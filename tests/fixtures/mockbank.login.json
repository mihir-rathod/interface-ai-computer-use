    {
      "step_id": "s2",
      "action": "type",
      "target": {
        "semantic_description": "username field",
        "locators": [
          { "strategy": "role", "value": "textbox[name='Username']" },
          { "strategy": "css", "value": "#username" }
        ]
      },
      "params": { "text": "{{username}}" },
      "checkpoint": {
        "type": "element_value_equals",
